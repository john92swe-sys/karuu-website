{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karuu-c-review-20261013",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "karuu-c-review-20261013"
    }
  ],
  "vars": {
    "KARUU_RUNTIME": "cloudflare",
    "KARUU_DEPLOYMENT_ENV": "preview",
    "KARUU_PAYMENTS_ENABLED": "false",
    "KARUU_PAYMENT_MODE": "test",
    "KARUU_LIVE_COMMERCE_APPROVED": "false",
    "KARUU_TAX_CONFIG_APPROVED": "false",
    "KARUU_DISTRIBUTION_APPROVED": "false",
    "KARUU_LEGAL_APPROVED": "false",
    "KARUU_HYPERDRIVE_CACHING_DISABLED": "false"
  }
}
