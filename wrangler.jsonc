{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karuu-c-review-20261013",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "karuu-c-review-20261013"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_COMMERCE",
      "id": "dc1f294919fa401db0a5ff90d969eb04"
    }
  ],
  "r2_buckets": [
    {
      "binding": "KARUU_PRIVATE_MEDIA",
      "bucket_name": "karuu-c-review-private-20261014",
      "jurisdiction": "eu"
    }
  ],
  "vars": {
    "KARUU_RUNTIME": "cloudflare",
    "KARUU_DATABASE_SCHEMA": "karuu_commerce",
    "KARUU_DEPLOYMENT_ENV": "preview",
    "KARUU_PAYMENTS_ENABLED": "false",
    "KARUU_PAYMENT_MODE": "live",
    "KARUU_SITE_ORIGIN": "https://karuu-c-review-20261013.john92swe.workers.dev",
    "KARUU_PRIVATE_MEDIA_PROVIDER": "r2",
    "KARUU_MAIL_PROVIDER": "smtp",
    "KARUU_MAIL_FROM": "john@karuu.net",
    "KARUU_SMTP_USER": "john@karuu.net",
    "KARUU_LIVE_COMMERCE_APPROVED": "false",
    "KARUU_TAX_CONFIG_APPROVED": "false",
    "KARUU_DISTRIBUTION_APPROVED": "false",
    "KARUU_LEGAL_APPROVED": "false",
    "KARUU_HYPERDRIVE_CACHING_DISABLED": "true",
    "KARUU_NOTIFICATIONS_SCHEDULED_ENABLED": "false"
  }
}
