{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "import/no-cycle": [
      "error",
      {
        "ignoreExternal": true
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "JSXOpeningElement[name.name=\"head\"]",
        "message": "Use Next.js metadata instead of a head element."
      }
    ]
  }
}
